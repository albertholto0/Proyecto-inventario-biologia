<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee           http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>AlertaController</servlet-name>
        <servlet-class>com.unsij.controllers.AlertaController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlertaController</servlet-name>
        <url-pattern>/alertas</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>MaterialController</servlet-name>
        <servlet-class>com.unsij.controllers.MaterialController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MaterialController</servlet-name>
        <url-pattern>/materiales</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LaboratorioController</servlet-name>
        <servlet-class>com.unsij.controllers.LaboratorioController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LaboratorioController</servlet-name>
        <url-pattern>/laboratorios</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AlumnoController</servlet-name>
        <servlet-class>com.unsij.controllers.AlumnoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlumnoController</servlet-name>
        <url-pattern>/alumnos</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EquipoController</servlet-name>
        <servlet-class>com.unsij.controllers.EquipoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EquipoController</servlet-name>
        <url-pattern>/equipos</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LoginRedirectServlet</servlet-name>
        <servlet-class>com.unsij.servlets.LoginRedirectServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.unsij.servlets.AuthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.unsij.servlets.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginRedirectServlet</servlet-name>
        <url-pattern>/showLogin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>404</error-code>
        <location>/pages/login.jsp</location>
    </error-page>
</web-app>
